{
  "name": "saxi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:browser": "tsx src/build/audit-browser.ts",
    "audit:links": "tsx src/build/audit-links.ts",
    "build": "npm run clean && npm run build:site && npm run build:css && npm run build:client",
    "build:site": "tsx src/build/index.ts",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./dist/assets/app.css --minify",
    "build:client": "node ./src/build/copy-client.mjs",
    "check": "npm run typecheck && wrangler types --check",
    "clean": "rm -rf dist",
    "cf:typegen": "wrangler types",
    "dev": "npm run build && wrangler dev",
    "screenshots:capture": "tsx src/build/capture-screenshots.ts",
    "screenshots:report": "tsx src/build/report-screenshots.ts",
    "social-card": "tsx src/build/render-social-card.ts",
    "sources:refresh": "tsx src/build/refresh-vendor-sources.ts",
    "typecheck": "tsc --noEmit",
    "validate:community-apis": "tsx src/build/validate-community-apis.ts",
    "verify:links": "node ./src/build/verify-links.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.3",
    "@types/node": "^24.5.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.13.0",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "zod": "^4.4.3"
  }
}
